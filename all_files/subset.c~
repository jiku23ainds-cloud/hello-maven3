#include <stdio.h>
int x[10];
int w[10];
int d;
int count = 0;
void subset(int cs, int k, int n) {
    if (cs == d) {
        printf("\n\nSubset %d\n", ++count);
        for (int i = 0; i < k; i++) {
            if (x[i] == 1) {
                printf("%d\t", w[i]);
            }
        }
    } else if (k < n) {
        x[k] = 1;
        subset(cs + w[k], k + 1, n);
        x[k] = 0;
        subset(cs, k + 1, n);
    }
}
int main() {
    int i, n, sum = 0;
    printf("Enter the number of elements: ");
    scanf("%d", &n);
    printf("\nEnter the elements in ascending order:\n");
    for (i = 0; i < n; i++) {
        scanf("%d", &w[i]);
        sum += w[i];
    }
    printf("\nEnter the sum: ");
    scanf("%d", &d);
    if (sum < d) {
        printf("No solution\n");
        return 0;
    }
    subset(0, 0, n);
    if (count == 0) {
        printf("No solution\n");
    }
    return 0;
}

