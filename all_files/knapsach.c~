#include <stdio.h>
int max(int a, int b) {
return (a > b) ? a : b;
}
void knapSack(int W, int wt[], int val[], int n) {
int i, w;
int dp[n+1][W+1];
for (i = 0; i <= n; i++) {
for (w = 0; w <= W; w++) {
if (i == 0 || w == 0)
dp[i][w] = 0;
else if (wt[i-1] <= w)
dp[i][w] = max(val[i-1] + dp[i-1][w - wt[i-1]], dp[i-1][w]);
else
dp[i][w] = dp[i-1][w];
}
}
int res = dp[n][W];
printf("Maximum value in Knapsack = %d\n", res);
w = W;
printf("Items included are:\n");
for (i = n; i > 0 && res > 0; i--) {
if (res == dp[i-1][w])
continue;
else {
printf("Item %d (Value: %d, Weight: %d)\n", i, val[i-1], wt[i-1]);
res -= val[i-1];
w -= wt[i-1];
}
}
}
int main() {
int val[] = {60, 100, 120};
int wt[] = {10, 20, 30};
int W = 50;
int n = sizeof(val) / sizeof(val[0]);
knapSack(W, wt, val, n);
return 0;
}
