#include<stdio.h>
#include<stdlib.h>
int main()
{
int i,n,x;
int arr[];

printf("enter the number of elements: ");
scanf("%d",&n);
for(i=0;i<n;i++)
{
scanf("%d",&arr[i]);
}
printf("enter element to search: ");
scanf("%d",&x);
for(int i=0;i<n;i++)
{
if (x==arr[i])
{
printf("found at position:%d",i+1);
exit(0);
}
}
printf("not found");
}
