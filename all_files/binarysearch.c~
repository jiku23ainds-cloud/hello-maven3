#include<stdio.h>
#include<stdlib.h>

int binsearch(int arr[],int size,int key){
int low=0;
int high=size-1;
while(low<=high){
int mid=low+(high-low)/2;
if(arr[mid]==key){
return mid;
}
else if(arr[mid]>key){
high=mid-1;
}
else{
low=mid+1;
}
}
return -1;
}
int main(){
int arr[]=[10,20,30,40,50];
int size=sizeof(arr[]);
int index= binsearch(arr,size,40);
printf("%d",&index);
}


