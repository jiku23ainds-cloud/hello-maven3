#include<iostream>
using namespace std;
int linear(int a[],int n,int k)
{
	for(int i=0;i<n;i++)
	{
		if(a[i]==k)
		{
			return i;
		}
	}
	return -1;
}
int main()
{
	int n;
	cout<<"Enter the no.of elements"<<endl;
	cin>>n;
	cout<<"Enter the array elements"<<endl;
	int a[n];
	for(int i=0;i<n;i++)
	{
		cin>>a[i];
	}
	int k;
	cout<<"Enter the search element"<<endl;
	cin>>k;
	cout<<"Element found at index:"<<linear(a,n,k)<<endl;
	return 0;
}
