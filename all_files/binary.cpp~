#include<iostream>
using namespace std;
int binary(int a[],int n,int k)
{
	int s=0;
	int e=n-1;
	while(s<=e)
	{
		int mid=(s+e)/2;
		if(a[mid]==k)
		{
			return mid;
		}
		else if(k<a[mid])
		{
			e=mid-1;
		}
		else
		{
			s=mid+1;
		}
	}
	return -1;
}
int main()
{
	int n;
	cout<<"Enter the no.of elements"<<endl;
	cin>>n;
	cout<<"Enter the array elements in sorted order"<<endl;
	int a[n];
	for(int i=0;i<n;i++)
	{
		cin>>a[i];
	}
	int k;
	cout<<"Enter the search element"<<endl;
	cin>>k;
	cout<<"Element found at index:"<<binary(a,n,k)<<endl;
	return 0;
}
