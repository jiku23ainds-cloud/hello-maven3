#include<stdio.h>
#include<ctype.h>
#define SIZE 100

int top=-1;
char stack[SIZE];

void push(char a)
{
	if(top==SIZE-1)
		printf("Overflow!\n");
	else
	{
		top++;
		stack[top]=a;
	}
}

int pop()
{
	if(top==-1)
		printf("Underflow!\n");
	else
		return stack[top--];
}

int prece(int b)
{
	if (b=='(')
		return 0;
	if (b=='^')
		return 1;
	if (b=='/'||'*'||'%')
		return 2;
	if (b=='+'||'-')
		return 3;
}
