#include<stdio.h>
#include<stdlib.h>
char stack[20],str[20];
int top=-1;

void push(char item){
top++;
stack[top]=item;
}

char pop(){
char item =stack[top];
top--;
return item;
}

int prec(char op){
switch(op)
{
case'^':
  return 3;
  break;
case'*':
case'/':
case'%':
  return 2;
  break;
case'+':
case'-':
  return 1;
  break;
default:
  return 0;
  break;
}
}

void convert(){
for(int i=0;str[i]!='\0';i++){
   switch(str[i]){
      case'(':
          push(str[i]);
          break;
      case')':
          printf("%c",pop());
          while(pop() != '('){
            printf("%c",pop());
          }
          break;
   case'+':
   case'-':
   case'*':
   case'/':
   case'%':
   case'^':
         while(top !=-1 && prec(str[i]) <= prec(stack[top])){
             printf("%c",pop());
             }
             push(str[i]);
             break;
   default:
   printf("%c",str[i]);
   break;
   }
}
while(top != -1)
{
  printf("%c",pop());
}
}
int main()
{
printf("Enter infix expression: ");
scanf("%s",str);
convert();
return 0;
}













