#include <stdio.h>
#include <stdlib.h>
#include <limits.h> // For INT_MAX

int main() {
    int n;
    printf("Enter the number of nodes: ");
    scanf("%d", &n);

    int costmat[n][n];
    printf("Enter the cost adjacency matrix:\n");
    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            scanf("%d", &costmat[i][j]);
        }
    }

    int source;
    printf("Enter the source vertex: ");
    scanf("%d", &source);

    int parent[n];
    int visited[n], distance[n];
    for (int i = 0; i < n; i++) {
        visited[i] = 0;
        parent[i] = source;
        distance[i] = costmat[source][i];
    }

    for (int i = 0; i < n; i++) {
        int min, u;
        min = INT_MAX; // Initialize min with a large value
        for (int j = 0; j < n; j++) {
            if (!visited[j] && distance[j] < min) {
                min = distance[j];
                u = j;
            }
        }
        visited[u] = 1;
        for (int v = 0; v < n; v++) {
            if (!visited[v] && distance[u] + costmat[u][v] < distance[v]) {
                distance[v] = distance[u] + costmat[u][v];
                parent[v] = u;
            }
        }
    }

    printf("Minimum distances from source %d:\n", source);
    for (int i = 0; i < n; i++) {
        printf("%d\t", distance[i]);
    }
    printf("\n");

    return 0;
}

