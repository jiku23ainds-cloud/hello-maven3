#include <stdio.h>
#include <time.h>
int search(int arr[], int N, int key)
{
    for (int i = 0; i < N; i++)
        if (arr[i] == key)
            return i;
    return -1;
}
int main(void)
{ 
     clock_t start_t,end_t;
     double total_t;
     start_t =clock();
	int n;
	printf("Enter the size of the array: ");
	scanf("%d", &n);
    int arr[n];
    for(int i=0;i<n;i++)
    	arr[i] = rand()%998;
    for(int i=0;i<=n;i++)
    	printf("%d ", arr[i]);
    int x;
    printf("Enter Key: ");
    scanf("%d", &x);
    //int N = sizeof(arr);
    int result = search(arr, n, x);
    if(result == -1)
          printf("Element is not present");
    else
    	printf("Element is present at index %d", result+1);
  
     end_t =clock();
    total_t=(double)(end_t-start_t)/(double)(CLOCKS_PER_SEC);
    printf("total time taken:%lf",total_t);
    return 0;
    }
    
