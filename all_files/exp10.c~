
#include <stdio.h>
#define MAX 50

int block[MAX]; 
int next[MAX];    
int n;


void allocateFile()
{
    int length;
    printf("Enter number of blocks needed: ");
    scanf("%d", &length);

    
    int freeCount = 0;
    for(int i = 0; i < n; i++)
        if(block[i] == 0)
            freeCount++;

    if(freeCount < length)
    {
        printf("Not enough free blocks!\n");
        return;
    }

    printf("\nAllocating %d blocks...\n", length);

    int start = -1, prev = -1;

    for(int i = 0; i < n && length > 0; i++)
    {
        if(block[i] == 0)
        {
            block[i] = 1;

            if(start == -1)
                start = i;   

            if(prev != -1)
                next[prev] = i;

            prev = i;
            length--;
            printf("Allocated block %d\n", i);
        }
    }

    next[prev] = -1; 
    printf("\nFile allocated successfully.\n");
    printf("Starting block = %d\n", start);
}
void display()
{
    printf("\nBlock\tAllocated\tNext\n");
    for(int i = 0; i < n; i++)
    {
        printf("%d\t   %d\t\t   %d\n", i, block[i], next[i]);
    }
}


int main()
{
    int choice;
    printf("enter the total number of blocks");
    scanf("%d",&choice);
    for(int i=0;i<n;i++){
     block[i] = 0;
     next[i] = -1;
    }
 switch(choice)
        {
            case 1: allocateFile(); break;
            case 2: display(); break;
            case 3: return 0;
            default: printf("Invalid choice!\n");
        }
    }
}

