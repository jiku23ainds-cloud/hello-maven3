#include<stdio.h>
struct process{
int size;
int flag;
int holeid;
}p[10];
struct hole{
int hid;
int size;
int actual;
}h[10];
int main()
{
int i,np,nh,j;
void bsort(struct hole[],int);
printf("enter the number of holes: ");
scanf("%d",&nh);
for(i=0;i<nh;i++)
{
printf("enter size for hole H%d: ",i);
scanf("%d",&h[i].size);
h[i].actual=h[i].size;
h[i].hid=1;
}
printf("\nenter the number of process: ");
scanf("%d",&np);
for(i=0;i<np;i++)
{
printf("enter size for process P%d: ",i);
scanf("%d",&p[i].size);
p[i].flag=0;
}
for(i=0;i<np;i++)
{
bsort(h,nh);
for(j=0;j<nh;j++)
{
if(p[i].flag!=1)
{
if(p[i].size<=h[j].size)
{
p[i].flag=1;
p[i].holeid=h[j].hid;
h[j].size-=p[i].size;
}
}
}
}
printf("\n\t best fit\n");
printf("\n process\tPsize\tHole");
for(i=0;i<np;i++)
{
if(p[i].flag!=1)
printf("\nP%d\t%d\t not allocated",i,p[i].size);
else
printf("\nP%d\t%d\tH%d",i,p[i].size,p[i].holeid);
}
printf("\n\n hole\tactual\tavailable");
for(i=0;i<nh;i++)
{
printf("\nH%d\t%d\t%d",h[i].hid,h[i].actual,h[i].size);
printf("\n");
}
}
void bsort(struct hole bh[],int n)
{
struct hole temp;
int i,j;
for(i=0;i<n-1;i++)
{
for(j=i+1;j<n;j++)
{
if(bh[i].size>bh[j].size)
{
temp=bh[i];
bh[i]=bh[j];
bh[j]=temp;
}
}
}
}

