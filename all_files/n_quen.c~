#include <stdio.h>
#include <stdlib.h>  // For abs()

#define MAX_N 10  // Define maximum size of the chessboard

void nqueens(int n);
int place(int x[], int k, int n);
void printsolution(int n, int x[]);

int main() {
    int n;
    printf("Enter the number of queens: ");
    scanf("%d", &n);

    if (n <= 0 || n > MAX_N) {
        printf("Number of queens should be between 1 and %d.\n", MAX_N);
        return 1;
    }

    nqueens(n);
    return 0;
}

void nqueens(int n) {
    int x[MAX_N + 1], count = 0, k = 1;
    x[k] = 0;

    while (k != 0) {
        x[k]++;
        while (x[k] <= n && !place(x, k, n)) {
            x[k]++;
        }
        if (x[k] <= n) {
            if (k == n) {
                count++;
                printf("\nSolution %d:\n", count);
                printsolution(n, x);
            } else {
                k++;
                x[k] = 0;
            }
        } else {
            k--; // Backtracking
        }
    }
}

int place(int x[], int k, int n) {
    for (int i = 1; i < k; i++) {
        if (x[i] == x[k] || abs(x[i] - x[k]) == abs(i - k)) {
            return 0;
        }
    }
    return 1;
}

void printsolution(int n, int x[]) {
    char c[MAX_N + 1][MAX_N + 1];
    for (int i = 1; i <= n; i++) {
        for (int j = 1; j <= n; j++) {
            c[i][j] = 'X';
        }
    }
    for (int i = 1; i <= n; i++) {
        c[i][x[i]] = 'Q';
    }
    for (int i = 1; i <= n; i++) {
        for (int j = 1; j <= n; j++) {
            printf("%c\t", c[i][j]);
        }
        printf("\n");
    }
}

