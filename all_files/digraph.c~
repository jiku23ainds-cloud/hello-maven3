#include<stdio.h>
#include<stdlib.h>

int a[50][50],n,visited[50];
int q[20],front=-1,rear=-1;
int s[20],top=-1,count=0;

void bfs(int v)
{
	int i,cur;
	visited[v]=1;
	q[++rear]=v;
	while(front!=rear)
	{
		cur=q[++front];
		for(i=0;i<n;i++)
			{
			if((a[cur][i]==1)&&(visited[i]==0))
			{
				q[++rear]=i;
				visited[i]=1;
				printf("%d",i);
			}
		}
	}
}

void dfs(int v)
{
	int i;
	visited[v]=1;
	s[++top]=v;
	for(i=0;i<n;i++){
		if(a[v][i]==1 && visited[i]==0)
		{
			printf("%d",i);
			dfs(i);
		}
	}
}


int main(){
	int ch,start,i,j;
	printf("Enter the vertices in graph");
	scanf("%d",&n);
	printf("Enter adjacency matrix:");
		for(i=0;i<n;i++){
			for(j=0;j<n;j++){
				scanf("%d",&a[i][j]);
			}
		}
	for(i=0;i<n;i++)
		visited[i]=0;
	printf("Enter index you want to start from:");
	scanf("%d",&start);
	while(1){
		printf("\n\nMENU\n1.BSF\n2.DSF\n3.EXIT\n");
		printf("Enter your choice:");
		scanf("%d",&ch);
		switch(ch){
			case 1:
				bfs(start);
				break;
			case 2:
				dfs(start);
				break;
			case 3:
				return 0;
				break;
			default:
				printf("Invalid choice");
		}
	}
	return 0;
}



































































