#include<stdio.h>
int main(){
	int arr[] = {5,11,12,6,4,9,10,3,14};
	int n = 9;
	int temp;
	int min;
	for(int i=0;i<n-1;i++){
		min=i;
		for(int j=0;j<n;j++){
			if(arr[min]>arr[j]){
				temp=arr[min];
				arr[min]=arr[j];
				arr[j]=temp;
			}
		}
	}
	for(int i=0;i<n;i++){
		printf("%d",arr[i]);
	}
}
