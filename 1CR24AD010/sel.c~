#include<stdio.h>
int main(){
	int arr[] = {5,11,12,6,4,9,10,3,14};
	int n = 9;
	int temp;
	int min;
	int i,j,k;
	for(i=0;i<n-1;i++){
		min=i;
		for(j=i+1;j<=n-1;j++){
			if(arr[min]>arr[j]){
				min=j;
			}
		}
		if(i!=min){
			temp=arr[min];
			arr[min]=arr[i];
			arr[i]=temp;
		}
	}
	for(k=0;k<n;k++){
		printf("%d ",arr[k]);
	}
}
