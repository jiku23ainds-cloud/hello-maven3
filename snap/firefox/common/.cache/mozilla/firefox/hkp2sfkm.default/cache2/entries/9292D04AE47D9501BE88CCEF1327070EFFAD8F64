function formatRupee(num) {
    var p = num.toFixed(2).split(".");
    return "<span class='WebRupee'></span>" + p[0].split("").reverse().reduce(function(acc, num, i, orig) {
        return  num + (i && !(i % 3) ? "," : "") + acc;
    }, "") + "." + p[1];
}

function getAbsoluteURL(){
	var fullURL = window.location.href;
	var startIndex = fullURL.indexOf('_')+1;
	var endIndex = fullURL.indexOf('?');
	var url = '';
	//alert('endIndex: '+endIndex);
	if(endIndex == -1){
		url = fullURL.substring(startIndex);+'</b>'
	} else {
		url = fullURL.substring(startIndex,endIndex);
	}
	//alert(url);
	return url;
}


String.prototype.nthIndexOf = function(pattern, n) {
    var i = -1;
    while (n-- && i++ < this.length) {
        i = this.indexOf(pattern, i);
        if (i < 0) break;
    }

    return i;
};

