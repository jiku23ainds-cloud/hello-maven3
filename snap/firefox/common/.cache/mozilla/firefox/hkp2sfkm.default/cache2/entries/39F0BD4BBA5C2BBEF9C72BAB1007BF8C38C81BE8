function submitFeedbackMentor(questionnaireType,mentorId)
{
	var followUpFeedbackDate=$('#mentiFeedbackDate').val();
	if(followUpFeedbackDate==""){
		jAlert("Please Select Date of Feedback..!");
		return;
	}

	$.ajax({ 
		url:'getFreezeUnfreezeStatusOfMentiFollowUpSheetList.json?followUpFeedbackDate='+followUpFeedbackDate+'&questionnaireType='+questionnaireType+'&mentorId='+mentorId,
		dataType :'text',
		type:'GET',
		async : false,
		beforeSend : function() {
			startCommonAjaxSpinner();
		},
		complete : function() {
			stopCommonAjaxSpinner();
		},
		success : function(jArray) {
			if(jArray=="Unfreez"){
				saveMentorFeedback(questionnaireType,mentorId);
			}else{
				jAlert("you have already given feedback of this Date!!!!!");
				return;
			}
		},
		error:function(e){
			getCustomAlertMessage("alert_error");
		}
	});

}


function saveMentorFeedback(questionnaireType,mentorId){
	date='';
	var QuetionarryFollowUp='';
	var Quetionarry1FollowUp='';
	var QuestionaryYesNofeedback ='';
	$('.trclsinstallmentMentor').each(function(){
		var RadioBut  = $(this).find('td').find(':checked').val();
		if(RadioBut=="")
		{
			jAlert("Please Provide Answers According To Questions");
		}
		var QuetionarriId=$(this).find('.trclsinstallmentIdMentor').html()==undefined || $(this).find('.trclsinstallmentIdMentor').html()==""?"-1":$(this).find('.trclsinstallmentIdMentor').html();
		if(QuetionarriId != -1){
			QuetionarryFollowUp+=QuetionarriId+'@'+RadioBut+'~';
		}
	});
	
	QuetionarryFollowUp=QuetionarryFollowUp.substring(0,QuetionarryFollowUp.length -1);
	console.log(QuetionarryFollowUp);
	$('.trclsinstallmentlmMentor').each(function(){
		
		var textAreaone  = $(this).find('#strengthText').val();
		if(textAreaone==undefined || textAreaone=="undefined"){
			var QurionarriId=$(this).find('.trclsinstallmentIdMentor').html()==undefined || $(this).find('.trclsinstallmentIdMentor').html()==""?"-1":$(this).find('.trclsinstallmentIdMentor').html();
			console.log($(this).find('td').find(':checked').val() +" text:::"+textAreaone);
			var valueofRadio = $(this).find('td').find(':checked').val();
			if(valueofRadio==""){
				jAlert("Please Provide Answers According To Questions");
			}
			QuestionaryYesNofeedback+=QurionarriId+'@'+valueofRadio+'~';
		}else{
			var QurionarriId=$(this).find('.trclsinstallmentIdMentor').html()==undefined || $(this).find('.trclsinstallmentIdMentor').html()==""?"-1":$(this).find('.trclsinstallmentIdMentor').html();
			date+=textAreaone+'@';
			if(textAreaone==""){
				Quetionarry1FollowUp+=QurionarriId+'@'+"null"+'~';
			}
			else{
				Quetionarry1FollowUp+=QurionarriId+'@'+textAreaone+'~';
			}
		}	
	});
	Quetionarry1FollowUp=Quetionarry1FollowUp.substring(0,Quetionarry1FollowUp.length -1);
	QuestionaryYesNofeedback=QuestionaryYesNofeedback.substring(0,QuestionaryYesNofeedback.length -1);

	var followUpFeedbackDate=$('#mentiFeedbackDate').val();

	if(followUpFeedbackDate==""){
		jAlert("Please Select Date of Feedback..!");
		return;
	}
	$.ajax({
		url:'submitMentorStudentFeedbackbyMenti.json?mentorId='+mentorId+'&QuetionarryFollowUp='+QuetionarryFollowUp.toString()+'&Quetionarry1FollowUp='+Quetionarry1FollowUp.toString()+'&questionnaireType='+questionnaireType+'&followUpFeedbackDate='+followUpFeedbackDate+'&QuestionaryYesNofeedback='+QuestionaryYesNofeedback,
//		dataType:'json',
		beforeSend: function() {
			startCommonAjaxSpinner();
		},
		complete: function() {
			stopCommonAjaxSpinner();
		},
		success:function(jArray){
			jAlert("Thanks for your valuable time.....","Message");
			getmentiFeedBackList();
		},
		error:function(){
			getCustomAlertMessage("alert_error");
		}
	});
	getBackMentorList()
}

