data: {"v": {"type": "message", "data": {"id": "6c2786b3-ea45-4d0a-93d9-0aa9502a8fe3", "author": {"role": "tool", "name": "web.run", "metadata": {"sonicberry_model_id": "current_gpt5_1_reasoning_paid", "real_author": "tool:web", "source": "sonic_tool"}}, "create_time": 1775327509.0305295, "update_time": null, "content": {"content_type": "text", "parts": [""]}, "status": "finished_successfully", "end_turn": false, "weight": 1.0, "metadata": {"search_result_groups": [{"type": "search_result_group", "domain": "www.wsj.com", "entries": [{"type": "search_result", "url": "https://www.wsj.com/tech/ai/anthropic-races-to-contain-leak-of-code-behind-claude-ai-agent-4bc5acc7", "title": "Anthropic Races to Contain Leak of Code Behind Claude AI Agent", "snippet": "Anthropic is urgently addressing a significant leak involving the internal source code behind Claude Code, its widely used AI agent app. The leak revealed proprietary developer instructions\u2014known as the \"harness\"\u2014that are essential for controlling and directing Claude AI models. Though no customer data or model weights were exposed, the breach involved highly sensitive techniques and tools core to Claude Code\u2019s functionality and competitive edge.\n\nThe leak stemmed from a human error during a software update that inadvertently exposed files linking to the source code on GitHub. An X user quickly spread the discovery, triggering widespread copying and modifications. Initially, Anthropic issued a broad takedown request affecting over 8,000 copies but later narrowed it to 96 targeted cases.\n\nProgrammers examining the code uncovered innovative features like memory consolidation (\"dreaming\"), covert identity protocols for AI-generated code-sharing, and references to future products\u2014including a virtual pet named \"Buddy.\" Competitors and developers now potentially have a roadmap to replicate key functions without reverse engineering.\n\nDespite the embarrassment, cybersecurity experts noted that the leak, while revealing, poses limited danger due to frequent code revisions and hackers' existing capabilities. The incident, however, threatens Anthropic\u2019s reputation for AI safety and secrecy amid its soaring valuation and upcoming IPO.", "ref_id": {"turn_index": 0, "ref_type": "news", "ref_index": 10}, "pub_date": 1775064180.0, "attribution": "www.wsj.com"}]}, {"type": "search_result_group", "domain": "en.wikipedia.org", "entries": [{"type": "search_result", "url": "https://en.wikipedia.org/wiki/GitHub", "title": "GitHub", "snippet": "", "ref_id": {"turn_index": 0, "ref_type": "search", "ref_index": 0}, "pub_date": null, "attribution": "en.wikipedia.org"}]}, {"type": "search_result_group", "domain": "github.com", "entries": [{"type": "search_result", "url": "https://github.com/about", "title": "About GitHub", "snippet": "GitHub is where people build software. More than 150 million people use GitHub to discover, fork, and contribute to over 420 million projects.", "ref_id": {"turn_index": 0, "ref_type": "search", "ref_index": 1}, "pub_date": null, "attribution": "github.com"}, {"type": "search_result", "url": "https://github.com/", "title": "GitHub \u00b7 Change is constant. GitHub keeps you ahead. \u00b7 GitHub", "snippet": "Tools and trends evolve, but collaboration endures. With GitHub, developers, agents, and code come together on one platform. Enter your email.Read more", "ref_id": {"turn_index": 0, "ref_type": "search", "ref_index": 2}, "pub_date": null, "attribution": "github.com"}]}, {"type": "search_result_group", "domain": "docs.github.com", "entries": [{"type": "search_result", "url": "https://docs.github.com/en/get-started/start-your-journey/about-github-and-git", "title": "About GitHub and Git", "snippet": "GitHub is a cloud-based platform where you can store, share, and work together with others to write code. Storing your code in a \"repository\" on GitHub allows ...Read more", "ref_id": {"turn_index": 0, "ref_type": "search", "ref_index": 3}, "pub_date": null, "attribution": "docs.github.com"}]}], "debug_sonic_thread_id": "thread_69d159150ba0832db4f87c7cada26a9d", "search_turns_count": 1, "search_source": "composer_auto", "client_reported_search_source": "composer_auto", "request_id": "71aa46a7-4b45-40cf-9932-cd47478caecb", "message_type": "next", "model_slug": "gpt-5-instant", "requested_model_slug": "gpt-5-instant", "parent_id": "ffc907f6-1d1b-445e-bfcb-c225eb4ee8b7", "turn_exchange_id": "60c3d65c-b161-44f3-80d4-dcc1542ca647"}, "recipient": "all", "channel": null}, "conversation_id": "69d15914-06c4-8323-b056-ed3f86862c36"}, "c": 4}  

