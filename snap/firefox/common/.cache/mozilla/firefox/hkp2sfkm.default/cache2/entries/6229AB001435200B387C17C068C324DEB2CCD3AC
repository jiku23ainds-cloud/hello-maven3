function sticky_relocate() {

	var window_top = $(window).scrollTop();
	var div_top = $('#tblFeedbackPlan').offset().top;
	if (window_top > div_top) {
		$('#tblFacultyDetail').addClass('stick');
		$('#tblFacultyDetail').css('top','2px');
	} else {
		$('#tblFacultyDetail').removeClass('stick');
		$('#tblFacultyDetail').css('top','');
	}
}

function manageGroupCheckBox(chkSrc,i,noOfGroup,groupNo)
{
	if($(chkSrc).is(':checked')) {
		for(var j=1;j<=noOfGroup;j++) {

			if(j!=groupNo) {
				$('.Group_'+i+'_'+j).attr('checked',false);
				$('.Group_'+i+'_'+j).attr('disabled',true);
			}
		}
	} else {
		if($('#Group_'+i+'_'+groupNo+':checked').length<1)
			$('.competencyGroup_'+i).attr('disabled',false);
	}
}

