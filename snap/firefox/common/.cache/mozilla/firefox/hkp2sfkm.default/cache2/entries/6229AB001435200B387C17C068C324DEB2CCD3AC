function getEmployeeListForStudentFeedback(attibuteID) {

	var feedkpaid=$('#feedkpaid').val();

	$.ajax({
		url : 'getEmployeeListForInstituteStudentFeedback.json?kpaPlanid='+feedkpaid+'&kpaplanattributeid='+attibuteID,
		dataType : 'json',
		async : false,
		beforeSend:function() {
			$('#loading').modal('show');
		},
		complete: function() {
			$('#loading').modal('hide');
		},
		success : function(jArray) {

			var j = jArray.length;
			var employeeId="";
			var subjectId="";
			var practical="";
			var boilerPlate = '';
			var first='';

			for ( var i = 0; i < j; i++) {
				employeeId=jArray[i]["allocatedToEmployeeId"];
				subjectId=jArray[i]["subjectId"];
				if(i==0)
					first=jArray[i]["practical"];

				practical=jArray[i]["practical"];
				boilerPlate += '<div  style="width: 94%; margin-left: 3%; margin-right: 3%;" id="EmployeeDiv'+i+'"><table class="smalltable"><tr>'+
				'<th><input type="hidden" id="hidpractical'+i+'" value="'+practical+'" /><strong>Faculty Name :</strong></th><th><label><strong>'
				+ jArray[i]["allocatedToname"]
				+ '</strong></label></th><th><strong>Course Name</strong></th><th><label><strong>'
				+ jArray[i]["subjectName"]
				+ '</strong></label></th></tr><tr><td colspan="5">'
				+ '<div style="width: 94%; margin-left: 3%; margin-right: 3%;" id="PerformanceMatrixForStudent'+i+'"></div>'+
				'</td></tr><tr><td colspan="4">';
				boilerPlate += '<input type="button" class="btn btn-inverse btn-mini  " id="savestudfeedback" value="Save & Next" onclick="SaveEmployeeFeedbackByStudent(\''+employeeId+'\','+subjectId+','+i+','+j+','+jArray[i]["employeeSubjectAllocationId"]+')" /></td>';
				boilerPlate += '</tr></table></div><div class="alert alert-error" id="errorMsg" style="display:none;">'+
				'<button type="button" class="close" data-dismiss="alert">Ã—</button>'+
				'<strong>Warning...!</strong> You must select all Parameter.'+
				'</div>';
			}
			boilerPlate += '</div>';
			if(j==0)
				boilerPlate='<div class="alert alert-error"><h3 style="color:red">You have already given feedback.</h3></td></div>';

			$("#middleframe").html(boilerPlate);
			PlanGenerationForStudent(0);
			for ( var i = 0; i < j; i++) {
				if (i != 0)
					$("#EmployeeDiv" + i).hide();
			}
		},
		error : function() {
//			jAlert("Something went wrong, Please try after some time","Error");
			getCustomAlertMessage("alert_error");
		}
	});

}

function PlanGenerationForStudent(DivIndex) {
	if($('#hidpractical'+DivIndex).val()=='Yes')
		$("#PerformanceMatrixForStudent"+DivIndex).html(kpaBoilerPlatePractical);
	else
		$("#PerformanceMatrixForStudent"+DivIndex).html(kpaBoilerPlate);

	$('#errorMsg').hide();
}

function SaveEmployeeFeedbackByStudent(employeeId,subjectId,currentDiv,totsize,employeeSubjectAllocationId)
{
	var gradevalue=new Array();
	var kpaplanid = $('#feedkpaid').val();

	var flag=0;
	var gval=0;
	var cnt=0;
	var gradetype='';

	var size='';
	if($('#hidpractical'+currentDiv).val()=='Yes')
	{
		gradetype=kpaGradeTypePractical;
		if(kpaGradeTypePractical=='alphabet')
		{

			$('.gradeval').each(function(){
				cnt++;
				if($(this).attr('checked'))
				{
					gradevalue[gval]=$(this).val();
					gval++;
				}
			});

			if(gradevalue.length!=csize)
				flag=1;
		}
		else
		{
			$('.gradeval').each(function(){
				cnt++;
				gradevalue[gval]=$(this).val();
				gval++;
			});
		}

		size=csize;
	}
	else
	{
		gradetype=kpaGradeTypeTheory;
		if(kpaGradeTypeTheory=='alphabet')
		{
			$('.gradeval').each(function(){
				cnt++;
				if($(this).attr('checked'))
				{
					gradevalue[gval]=$(this).val();
					gval++;
				}
			});

			if(gradevalue.length!=csize)
				flag=1;
		}
		else
		{
			$('.gradeval').each(function(){
				cnt++;
				gradevalue[gval]=$(this).val();
				gval++;
			});
		}

		size=csize;
	}

	var tempArray=new Array();

	if($('#matrixfor').text()=='Cousre Type :theory')
		tempArray=kpaScheduleAttributecompetencyid;
	else
		tempArray=kpaScheduleAttributecompetencypracticalid;

	if(flag==0)
	{	
		var commonComment=$('#feedcomment').val();
		$.ajax({
			url :'saveStudentPerformanceMatrixForInstituteAppraisal.json?employeeId='+employeeId+'&subjectId='+subjectId+'&kpaScheduleAttributecompetencyid='+tempArray+'&gradevalue='+gradevalue+'&competencysize='+size
			+'&commonComment='+commonComment+'&feedkpaid='+kpaplanid+'&employeeSubjectAllocationId='+employeeSubjectAllocationId+'&gradetype='+gradetype,
			async:false,
			beforeSend:function() {
				$('#loading').modal('show');
			},
			complete: function() {
				$('#loading').modal('hide');
			},
			success:function() {
				var intcurrentDiv = parseInt(currentDiv);
				var intNextDiv = intcurrentDiv + 1;
				PlanGenerationForStudent(intNextDiv);
				$("#EmployeeDiv" + intcurrentDiv).remove();
				$("#EmployeeDiv" + intNextDiv).show();
				if((totsize)==intNextDiv)
				{
					var submitboiler='<table class="table"><tr><td><h3 style="color:green">Your feedback is valuable to us. Thank you for your time.</h3></td></tr></table>';
					$("#middleframe").html(submitboiler);


					$.ajax({
						url :'afterfeedchangestudpassword.json',
						async:false,
						success:function() {

						},
						error : function() {
							alert("In grade error");
						}
					}); 
				}	
			},
			error : function() {
				alert("In grade error");
			}
		});
	}
	else
	{
		$('#errorMsg').show();
	}
}
