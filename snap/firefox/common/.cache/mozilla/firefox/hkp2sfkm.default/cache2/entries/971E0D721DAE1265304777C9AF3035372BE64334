 * @since 30th Mar 2012
 * @purpose returns the category path of the document the upload form for
 *          uploading the file
 */
function getCategoryPath(nodeId, callback) {
	var catPath = "";
	$.ajax({
		url : 'getCategoryPathAjax.json?categoryId=' + nodeId,
		dataType : 'text',
		async : false,
		success : function(response) {
			try {
				callback(response);
			} catch (e) {
				catPath = response;
			}
		},
		error : function() {

		}
	});
	return catPath;
}

