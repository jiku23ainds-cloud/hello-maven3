		$.ajax({
			url : 'getDocumentCategoryAjaxDMS_Sp.json?categoryPath=' + categoryPath
			+ '&typeArray=' + typeArray.toString() + '&parentType=' + parentType.toString()
			+ '&root=' + rootRquired+'&isHideEmptyFolders='+isHideEmptyFolders+''+searchTagTxt,
