			beforeSend : function() {
				startCommonAjaxSpinner();
			},
			complete : function() {
				stopCommonAjaxSpinner();
			},
			success : function(jArray) {
				gCreateTreeArr = jArray;
				doCreateTree(jArray);
				
				//alert(jArray.length);
				doCreateOrganizeFolderTree(jArray);
				showZipDownloadButton();
			},
			error : function() {
			}
		});
	}	
	

}

