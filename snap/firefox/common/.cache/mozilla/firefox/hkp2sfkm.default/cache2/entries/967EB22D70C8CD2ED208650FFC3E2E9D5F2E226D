function markAttendance(tdSrc)
{
	var trSrc=$(tdSrc).closest('tr');
	var temp=($(trSrc).attr('id').toString());

	if(($(tdSrc).html().toString()!='E' && ($('#customerHelper').val() == "NIET" || $('#customerHelper').val() == "MGMU")) || ($('#customerHelper').val() != "NIET" && $('#customerHelper').val() != "MGMU")){
		if($(tdSrc).html().toString()=='P'){
			$(tdSrc).html('A');

			if($.inArray(temp,prStdList)!=-1)
				prStdList.splice(prStdList.indexOf(temp),1);


			if($.inArray($(trSrc).attr('id').toString(),abStdList)==-1)
				abStdList.push($(trSrc).attr('id').toString());
		}else{
			$(tdSrc).html('P');

			if($.inArray(temp,abStdList)!=-1)
				abStdList.splice(abStdList.indexOf(temp),1);

			if($.inArray($(trSrc).attr('id').toString(),prStdList)==-1)
				prStdList.push($(trSrc).attr('id').toString());
		}
	}
	
	

}

