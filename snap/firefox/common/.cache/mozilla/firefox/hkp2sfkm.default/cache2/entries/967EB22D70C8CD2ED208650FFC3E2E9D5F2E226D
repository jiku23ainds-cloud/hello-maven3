function pad0(n) {
	if (n < 10) {
		return '0' + n;
	}
	return n;
}
function getShotDate(dt) {
	var dt1 = new Date(dt);
	return pad0(dt1.getHours()) + ":" + pad0(dt1.getMinutes());
}

