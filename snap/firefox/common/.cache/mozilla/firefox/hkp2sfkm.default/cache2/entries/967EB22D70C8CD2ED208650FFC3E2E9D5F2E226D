function selectStudentForAttendanceRecord(src,subStdId,stdrollNo,subWiseBatchId)
{

	var caseType = ($('input[name="caseType"]:checked').val());
	if($(src).is(':checked')) {
		if($.inArray(subStdId,workSheetStdAttendance)==-1 || $.inArray(subStdId.toString(),workSheetStdAttendance)==-1){
			workSheetStdAttendance.push(subStdId);
		}
	} else {
		if($.inArray(subStdId,workSheetStdAttendance)!=-1)
			workSheetStdAttendance.splice(workSheetStdAttendance.indexOf(subStdId),1);
		else if($.inArray(subStdId.toString(),workSheetStdAttendance)!=-1)
			workSheetStdAttendance.splice(workSheetStdAttendance.indexOf(subStdId.toString()),1);
	}

	var stdRollList = new Array();
	if(caseType =='OnlyRollNos') {
		$(".stdRollNo-"+subWiseBatchId+":checked").each(function() {
			var id = $(this).attr('id');
			stdRollList.push($('#stdLbl_'+id.split('inpt_')[1]+' span').html());
		});
	} else {
		$(".stdRollNo-"+subWiseBatchId+":checked").each(function() {
			stdRollList.push($(this).attr('value').split('_')[0]);
		});
	}
	$('#txtRollNoList-'+subWiseBatchId).val(stdRollList);
}

