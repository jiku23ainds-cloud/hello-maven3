	            // Set the 'To Date' to the same value initially
	            $('#workloadEdate').datepicker("setDate", fromDate);

	            // Set minDate so that To Date cannot be earlier than From Date
	            $('#workloadEdate').datepicker("option", "minDate", fromDate);
	        }
	    }
	});

	// Initialize To Date with options (it will be updated on From Date selection)
	$("#workloadEdate").datepicker({
	    dateFormat: "M dd,yy",
	    showWeek: true,
	    changeMonth: true,
	    changeYear: true,
	    yearRange: "-60:+1"
	});
