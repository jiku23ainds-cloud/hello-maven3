function todaysDate(dt)
{
	var monArray = ["Jan","Feb","Mar", "Apr", "May", "Jun", "Jul", "Aug","Sep","Oct","Nov", "Dec"];
	var today = new Date();
	if(dt)
	{
		today = new Date(dt);
	}

	//var today = new Date();
	var strDay = today.getDate();
	var strMonth = today.getMonth();
	var strYear = today.getYear();

	if (strYear < 1000)
		strYear += 1900;
	strMonth = monArray[strMonth];
	return strMonth + " " +strDay + "," + strYear;
}

