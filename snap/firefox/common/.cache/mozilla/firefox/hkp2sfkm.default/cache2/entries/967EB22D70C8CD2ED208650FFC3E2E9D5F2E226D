function submitScheduleWebConference(subjectName,startDate,startDate1,startTime,seTime,endTime,eeTime,externalWebEventsId,instituteCourseBatchSemesterConductedTimeTableId){
	var title = subjectName;
	var Description = 'Lecture For :'+title+' On '+startDate+' - '+seTime+' To '+eeTime+'.';
	var externalEventType = $('#externalEventType'+instituteCourseBatchSemesterConductedTimeTableId).val();
	
	var studentEmailWithDetail = new Array();
	$('.productType').each(function(){
		if($(this).is(':checked')){
			var emailId = $(this).attr("emailId");
			var name = $(this).attr("name");
			var rollNo = $(this).attr("rollNo");
			var nameWithRollAndEmail = 'Roll No. - '+rollNo+' Student Name - '+name+'~~'+emailId;
			studentEmailWithDetail.push(nameWithRollAndEmail);
		}
	});
	if(studentEmailWithDetail.length<1){
		jAlert("Please Select At Least One Student!!!");
		return false;
	}
	if(externalEventType == "0"){
		jAlert("please select External Event Type");
		return false;
	}
	$.ajax({
		url:'submitScheduleWebConference.json',
		dataType: 'text',
		type:'POST',
		data:{
			attendies:studentEmailWithDetail.toString(),
			title:title,
			Description:Description,
			lectureDate:startDate1,
			lecStartTime:startTime,
			lecEndTime:endTime,
			__externalWebEventsId:externalWebEventsId,
			insCourBatchSemConductedTimeTableId:instituteCourseBatchSemesterConductedTimeTableId,
			type:externalEventType
		},
		beforeSend: function() {
			startCommonAjaxSpinner();
		},
		complete: function() {
			stopCommonAjaxSpinner();
		},
		async: false,
		success: function(replay) {
			jAlert(replay);
			if(replay == "Submitted Successfully..."){
				$('#scheduleWebConferenceDialog').modal('hide');
			}
		},
		error: function(){
			jAlert("Something went wrong, Please try after some time","Error");
		}
	});
	showWorkLoadScheduleToday();
}

