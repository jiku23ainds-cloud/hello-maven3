function selectingStudentForAttendanceRecord(btnSrc)
{
	var markedstudentRollNoList=new Array();
	if($('#txtRollNoList').val().toString().trim()!="")
		markedstudentRollNoList=$('#txtRollNoList').val().toString().trim().split(',');

	if($(btnSrc).is(':checked'))
	{
		var stdrollNo = $(btnSrc).attr('id').toString().split('_')[1];

		if($.inArray(stdrollNo,markedstudentRollNoList)==-1)
			markedstudentRollNoList.push(stdrollNo);
