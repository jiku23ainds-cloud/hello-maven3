function convertTo12Hr(time24Hr) {
	if (time24Hr.split(":").length == 2) {
		var hour = eval(time24Hr.split(":")[0]);
		var min = eval(time24Hr.split(":")[1]);
		var amPm = "AM";
		
		if(hour >= 12)
			amPm = "PM";
		
		if (hour > 12)
			hour = hour - 12;
		
		
		if (hour < 10)
			hour = "0" + eval(hour);

		if (hour == "00") {
			hour = "12";
			amPm = "AM";
		}

		if (min < 10)
			min = "0" + eval(min);

		return hour + ":" + min + " " + amPm;
	} else {
		return "";
	}
}

