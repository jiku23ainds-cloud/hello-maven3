		var isTemporary = jArray[i]["isTemporary"];
		var documentType = jArray[i]["documentType"];
		var trId = 'trAttachmentFile-'+documentId+i;
		
		var fileType = jArray[i]["type"];
		iconPath = gFileTypeIcon[fileType];
		
		attachementBoiler += 
			'<tr id = "'+trId+'"><td><img src="'+iconPath+'" style="height:30px;"/>&nbsp;&nbsp;&nbsp;&nbsp;'+attachmentFileName+'</td>';
		
		if(!isTemporary){
			
			if(documentType == 'uploaded'){
				attachementBoiler += 
					'<td><a class="btn btn-mini" title="Download" href = "'+downloadLink+'"  target="_blank"><i class="icon-download"></i></a>&nbsp;';
			} else {
				attachementBoiler += 
					'<td><a class="btn btn-mini" title="Download" href = "javascript:void(0)" onclick="showTextDocumentForAlumini(\''+documentId+'\',\''+person+'\')"><i class="icon-download"></i></a>&nbsp;';
			}	
			
			if(isCreator){
				attachementBoiler += '<a class="btn btn-mini" href = "javascript:void(0)" title = "Remove" onclick="removeSchedulerTimeTableAttachmentAjax(\''+trId+'\',\''+documentId+'\',\'saved\', \''+fileType+'\')"><i class="icon-trash"></i></a>&nbsp;'; 
			}
			
			if(!isCreator){
				attachementBoiler += '<span id = "stdbtn-'+documentId+'" documenttype="'+documentType+'" person="'+person+'" class="btn btn-mini btn-stdbtn" title="Save to drive"><i class="icon-inbox"></i></span>&nbsp';
			}
			
			if(fileType.toLowerCase()=='doc' || fileType.toLowerCase()=='docx' || fileType.toLowerCase()=='ppt' || fileType.toLowerCase()=='pptx' || fileType.toLowerCase()=='xls' || fileType.toLowerCase()=='xlsx')
				attachementBoiler += '<a class="btn btn-mini docListOpt btnDocOpts" href="javascript:void(0);" title="Preview" onclick="showDocumentPreview('+documentId+');"><i class="icon-share"></i></a>';
			
			
		} else {
			attachementBoiler += 
				'<td><a class="btn btn-mini" href = "javascript:void(0)" title = "Remove" src = "img/remove-icon.png" onclick = "removeSchedulerTimeTableAttachmentAjax(\''+trId+'\',\''+documentId+'\',\'temporary\',\''+documentType+'\')"><i class="icon-trash"></i></a>&nbsp;&nbsp;<img src = "img/unsaved.png" title = "Unsaved"/>';
		}
		attachementBoiler += '</td>';
		attachementBoiler +=  '</tr>';
		
		//alert(attachementBoiler);
	}
	attachementBoiler += "</table>";
	if(tableId == undefined)
		$('#showQuotationAttachment').html(attachementBoiler);
	else
		$('#'+tableId).html(attachementBoiler);
	//alert(person);
	$('.btn-stdbtn').unbind();
	$('.btn-stdbtn').bind('click',function(){
		var elementId = $(this).attr('id');
		var documentType = $(this).attr('documenttype');
		var documentId = elementId.split('-')[1];
		new DriveTransfer({
			elementId:elementId,
			documentId:documentId,
			documentType:documentType,
			person:person,
			success:function(responseObject){
				var documentId = responseObject.documentId;
				//alert(newDocumentId);
			},
		});
	});
}

