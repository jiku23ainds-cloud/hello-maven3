function convertTo24Hr(time12Hr) {
	var hh = 0;
	var mm = 0;
	time12Hr = $.trim(time12Hr);

	if (time12Hr.split(" ").length == 2) {
		hh = eval(time12Hr.split(" ")[0].split(":")[0]);
		mm = eval(time12Hr.split(" ")[0].split(":")[1]);

		hh = time12Hr.split(" ")[1] == "PM" ? (hh  % 12 ) + 12 : (hh  % 12 );
		/*if (time12Hr.split(" ")[1] == "PM") {
			if(hh < 12)
				hh = (hh + 12) % 24;
		}*/
	} else if (time12Hr.split(":").length == 2) {
		hh = time12Hr.split(":")[0];
		mm = time12Hr.split(":")[1];
	}

	if (eval(hh) < 10)
		hh = "0" + eval(hh);

	if (eval(mm) < 10)
		mm = "0" + eval(mm);

	return hh + ":" + mm;
}

